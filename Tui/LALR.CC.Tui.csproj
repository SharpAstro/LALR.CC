<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Terminal UI debugger for LALR grammars. Loads a *.lalr.yaml file, runs it
    through SchemaCompiler, and shows the resulting Grammar / lexer rules /
    token stream in a Console.Lib-driven dock layout. Inspired by GOLD Parser
    (the windows-only original). Cross-platform — net10.0, no -windows TFM.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LALR.CC.Tui</RootNamespace>
    <AssemblyName>lalr-tui</AssemblyName>
    <!--
      AOT is intentionally OFF for the TUI. YamlDotNet's reflection-based
      deserializer doesn't survive trimming (the schema POCOs work, but
      YamlDotNet's own internals do not — IL2104/IL3053 warnings from the
      package itself, not from our code). Switching to StaticDeserializerBuilder
      would require generating per-type binders for the schema, which is on
      the roadmap once Phase 5 (compiler-compiler / pre-baked tables) lands —
      that generator can emit the static deserializer too. Until then this
      project ships as a JIT exe; the runtime library + Bootstrap + examples
      remain AOT-clean.
    -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LALR.CC\LALR.CC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet — used to deserialize *.lalr.yaml into GrammarSchema at
         runtime (matches what the source generator does at build time). -->
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
  </ItemGroup>

  <!--
    Console.Lib — dock layout, TreeView, TextArea, ScrollableList, VtStyle.
    Mirrors the DIR.Lib pattern from Console.Lib's own csproj: when a sibling
    working copy of `sharpastro/Console.Lib` exists on disk we pick it up as
    a ProjectReference (great for in-tree iteration of TUI features), otherwise
    fall back to the published NuGet package. The switch is controlled by the
    `UseLocalConsoleLib` MSBuild property and can be forced explicitly.
  -->
  <PropertyGroup>
    <UseLocalConsoleLib Condition="'$(UseLocalConsoleLib)' == '' AND Exists('..\..\..\sharpastro\Console.Lib\src\Console.Lib\Console.Lib.csproj')">true</UseLocalConsoleLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' == 'true'">
    <ProjectReference Include="..\..\..\sharpastro\Console.Lib\src\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' != 'true'">
    <!-- Wildcard within the minor, matching how every other consumer of the SharpAstro siblings pins
         them: they publish X.Y.<ci_run_number>, so a fixed patch has to be hand-edited after each
         release and silently rots instead. This pin was 2.10.501 (two majors behind), which only
         went unnoticed because a sibling working copy on disk wins over the package, so the package
         path was never exercised locally. -->
    <PackageReference Include="Console.Lib" Version="4.10.*" />
  </ItemGroup>

  <!--
    DIR.Lib provides Layout.Node / Layout.Builder / RGBAColor32, and is referenced DIRECTLY. The TUI's rows and
    tree nodes describe themselves as layout trees (Console.Lib 4.10's IRowLayout and
    ITreeNode.BuildNodeContent), so DIR.Lib types now appear in this project's own source. It does
    arrive transitively through Console.Lib either way, but leaning on a transitive for types you name
    yourself breaks the day the intermediate stops needing them, and it reads as an accident rather
    than a dependency. Same local-sibling switch as Console.Lib above, so the two cannot disagree
    about whether they are packages or projects; a project Console.Lib plus a package DIR.Lib would
    load two DIR.Lib identities.
  -->
  <PropertyGroup>
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == '' AND '$(UseLocalConsoleLib)' == 'true' AND Exists('..\..\..\sharpastro\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')">true</UseLocalDirLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' == 'true'">
    <ProjectReference Include="..\..\..\sharpastro\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' != 'true'">
    <PackageReference Include="DIR.Lib" Version="7.3.*" />
  </ItemGroup>

</Project>
